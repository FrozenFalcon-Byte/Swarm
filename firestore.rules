rules_version = '2';
// Clients read what they are a member of and can only *request* work.
// Tasks, tools, activity and stats are written by the worker (Admin SDK bypasses rules),
// so a browser can never push a card through the state machine itself.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admins (the test lab) are listed in admins/{uid}, written only with `swarm admin add`.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function labWaves(d) {
      return d.lab is map && d.lab.keys().hasOnly(['waves']) && d.lab.waves is list && d.lab.waves.size() <= 20;
    }
    function isMember(repoId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/repos/$(repoId)).data.members;
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // the profile picture is a small cropped WebP kept inline (no Cloud Storage on the free plan)
      allow create, update: if signedIn() && request.auth.uid == uid
        && (!('avatar' in request.resource.data) || request.resource.data.avatar == null
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 300000
                && request.resource.data.avatar.matches('^data:image/(webp|jpeg|png);base64,.*')));
      // GitHub access token for cloning private repos and opening PRs: owner-only.
      match /private/{doc} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.token is string && request.resource.data.token.size() < 400
          && request.resource.data.keys().hasOnly(['token', 'source', 'scopes', 'login', 'avatarUrl', 'savedAt']);
      }
    }

    match /repos/{repoId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && (request.resource.data.source in ['github', 'demo']
            || (request.resource.data.source == 'lab' && isAdmin() && labWaves(request.resource.data)))
        && request.resource.data.fullName is string
        && request.resource.data.status == 'queued'
        && request.resource.data.keys().hasOnly(['fullName', 'displayName', 'source', 'ownerUid', 'members', 'status',
             'createdAt', 'defaultBranch', 'private', 'htmlUrl', 'description', 'settings', 'lab']);
      // owners may rename/pause/delete; workers own everything else on the doc
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'paused', 'settings'])
            || (resource.data.source in ['lab', 'demo'] && isAdmin() && labWaves(request.resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lab'])))
        && (!('settings' in request.resource.data) || !('secondOpinionAgents' in request.resource.data.settings)
            || (request.resource.data.settings.secondOpinionAgents is list && request.resource.data.settings.secondOpinionAgents.size() <= 3));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /tasks/{taskId} { allow read: if isMember(repoId); }
      match /tools/{toolId} { allow read: if isMember(repoId); }
      match /activity/{id} { allow read: if isMember(repoId); }
      // A2A traffic between the agents (messages, status updates, results), written by the worker
      match /a2a/{id} { allow read: if isMember(repoId); }
      // test-lab waves: the made-up files, issues, and the answer key (root causes and fixes)
      match /lab/{id} { allow read: if isMember(repoId); }

      match /runs/{runId} {
        allow read: if isMember(repoId);
        allow create: if isMember(repoId)
          && request.resource.data.status == 'queued'
          && request.resource.data.requestedBy == request.auth.uid;
      }
      match /actions/{actionId} {
        allow read: if isMember(repoId);
        allow create: if isMember(repoId)
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['merge', 'approve', 'reject', 'reopen', 'close'];
      }
    }

    // MCP access tokens, keyed by the SHA-256 of the token. The browser that makes one writes the hash;
    // the plain token is shown once and never stored. Deleting the document revokes the token.
    match /mcpTokens/{hash} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'prefix', 'createdAt', 'lastUsedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.prefix is string && request.resource.data.prefix.size() <= 16;
    }

    // Passkeys: created only by the server after it verifies them; the owner can rename or remove them.
    match /passkeys/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
    }

    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; }

    // Worker heartbeats: any signed-in user may see whether a worker is online.
    match /workers/{id} { allow read: if signedIn(); }
  }
}
