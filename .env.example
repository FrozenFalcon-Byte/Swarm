# Swarm worker configuration. Copy to .env (never commit .env) and fill in what you use.
# Real environment variables override this file. Check everything with: swarm doctor

# --- Firebase (required for the service) -----------------------------------------------
# Firebase console → Project settings → General → Project ID
FIREBASE_PROJECT_ID=
# Firebase console → Build → Storage → the bucket name without gs:// (usually <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
# Firebase console → Project settings → Service accounts → Generate new private key → save the JSON file
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# ...or paste the whole JSON on one line instead (for hosts without a filesystem, e.g. Railway, Fly)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- GitHub (optional) -------------------------------------------------------------------
# Users connect their own GitHub in the app. This is only a fallback for repos whose owner hasn't.
# github.com/settings/tokens → fine-grained token: Contents (read/write), Issues (read), Pull requests (read/write)
GITHUB_TOKEN=
# Look for new issues on connected repos every N minutes (0 = only when someone presses Run)
SWARM_SYNC_MINUTES=10

# --- Models (all optional; tried in this order, the agents fall back to heuristics) ------
# Local: install Ollama (ollama.com), then `ollama pull qwen2.5-coder:7b`
OLLAMA_HOST=http://127.0.0.1:11434
SWARM_OLLAMA_MODEL=qwen2.5-coder:7b
# Free: console.groq.com/keys
GROQ_API_KEY=
# Free: aistudio.google.com/apikey
GEMINI_API_KEY=
# Free models: openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Paid: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# SWARM_LLM_PROVIDERS=ollama,groq,gemini,openrouter,anthropic

# --- Sandbox -----------------------------------------------------------------------------
# auto = Docker when available (network off), else local subprocess
SWARM_SANDBOX=auto
SWARM_HOME=.swarm-service
