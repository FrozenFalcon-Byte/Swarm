{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "swarm-board",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "swarm.cli",
        "serve",
        "--demo",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}